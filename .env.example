# Merchant Ops MCP API key from Synerixis → Connections. Prefix is sxk_.
SYNERIXIS_OPS_MCP_API_KEY=sxk_xxxxxxxx
# Optional. Default is production. https only, host must be api.synerixis.com (or a subdomain).
# SYNERIXIS_OPS_MCP_BASE_URL=https://api.synerixis.com/api/ops-mcp/v1
# Local API only: set this to 1 and point BASE_URL at http://localhost or http://127.0.0.1.
# SYNERIXIS_OPS_MCP_ALLOW_INSECURE_LOCAL=1
