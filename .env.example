# Used by optional stdio shell AND as the value for plugin variable / Authorization Bearer.
# Merchant console → Connections. Prefix is sxk_. Never commit a real key.
SYNERIXIS_OPS_MCP_API_KEY=sxk_xxxxxxxx
# Remote default URL (no env needed for HTTP install):
#   https://api.synerixis.com/api/ops-mcp/v1/mcp
# Optional stdio BASE_URL. Default is production. https only, host must be api.synerixis.com.
# SYNERIXIS_OPS_MCP_BASE_URL=https://api.synerixis.com/api/ops-mcp/v1
# Local API only: set this to 1 and point BASE_URL at http://localhost or http://127.0.0.1.
# SYNERIXIS_OPS_MCP_ALLOW_INSECURE_LOCAL=1
